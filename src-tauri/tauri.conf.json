{
  "productName": "BitCraft Overlay",
  "version": "0.1.0",
  "identifier": "com.bitcraft.overlay",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BitCraft Overlay",
        "width": 240,
        "height": 300,
        "minWidth": 200,
        "minHeight": 30,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
