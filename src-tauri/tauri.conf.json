{
  "productName": "BitCraft Overlay",
  "identifier": "com.bitcraft.overlay",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "BitCraft Overlay",
        "width": 360,
        "height": 520,
        "minWidth": 300,
        "minHeight": 80,
        "resizable": true,
        "decorations": false,
        "alwaysOnTop": true,
        "shadow": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' https://bitjita.com asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; media-src 'self'",
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": "v1Compatible",
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IERCMzJCQ0ZBODBFRDVCRTYKUldUbVcrMkErcnd5MjhzYmkrbGFacVE2Y1RqbXlJZyszNk9LTCswSmh2ZE01WDVDUXdKN2ZIR1IK",
      "endpoints": [
        "https://github.com/Alexxpalo/bitcraft-overlay/releases/latest/download/latest.json"
      ],
      "dialog": false
    }
  }
}
